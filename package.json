{
  "name": "schema-lens-mcp",
  "version": "0.1.0",
  "description": "Token-efficient database schema for AI coding assistants (MCP server + CLI)",
  "type": "module",
  "bin": {
    "schema-lens-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smitpataliya/schema-lens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/smitpataliya/schema-lens-mcp/issues"
  },
  "homepage": "https://github.com/smitpataliya/schema-lens-mcp#readme",
  "author": "Smit Pataliya <smitsoni004@gmail.com>",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "bench": "vitest run test/unit/benchmark.test.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "schema",
    "postgres",
    "mysql",
    "sqlite",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "gpt-tokenizer": "^4.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
